# --- mediu ---
# 'test' sau 'prod'. In dev API-ul refuza pornirea daca e 'prod'.
ANAF_ENVIRONMENT=test
# `prod` porneste verificarea care refuza un rol ce ocoleste RLS.
APP_ENV=dev
LOG_LEVEL=INFO

# --- baza de date ---
POSTGRES_USER=facturare
POSTGRES_PASSWORD=schimba_ma
POSTGRES_DB=facturare
# DOUA roluri, doua URL-uri. Postgres ignora politicile RLS pentru SUPERUSER
# si pentru rolurile cu BYPASSRLS, iar imaginea oficiala creeaza POSTGRES_USER
# ca SUPERUSER. Daca aplicatia se conecteaza cu el, izolarea intre firme e
# inactiva desi toate politicile sunt la locul lor. In productie, `app/db.py`
# refuza pornirea; vezi scripts/setup-db-roles.sh.
#
# In dev poti lasa acelasi rol in ambele: primesti doar un avertisment.
DATABASE_URL=postgresql+psycopg://facturare_app:schimba_ma_si_pe_asta@db:5432/facturare
# Proprietarul schemei. Folosit DOAR de alembic. Gol => cade pe DATABASE_URL.
ADMIN_DATABASE_URL=postgresql+psycopg://facturare:schimba_ma@db:5432/facturare

# --- cozi ---
REDIS_URL=redis://redis:6379/0

# --- criptare tokenuri SPV (Fernet, 32 bytes base64) ---
# genereaza: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- ANAF OAuth ---
# O SINGURA inregistrare pentru ambele medii. Separarea test/prod e doar pe calea de API.
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=https://facturare.fullstackit.ro/anaf/callback

# --- domenii Traefik ---
DOMAIN=facturare.fullstackit.ro
# Reteaua docker pe care sta reverse proxy-ul EXISTENT de pe server (nginx, nu
# Traefik). API-ul se leaga la ea ca sa fie vizibil ca `facturare-api:8000`.
# Vezi docs/deployment.md si deploy/nginx/facturare.conf.
WEB_NETWORK=apps-net
# Folosite doar de docker-compose.dev.yml, unde ruleaza Traefik.
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=letsencrypt

# --- stocare ---
STORAGE_PATH=/data/storage
SCHEMATRON_PATH=/data/schematron/ro16931-ubl-1.0.9
