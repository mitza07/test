# --- mediu ---
# 'test' sau 'prod'. In dev API-ul refuza pornirea daca e 'prod'.
ANAF_ENVIRONMENT=test
APP_ENV=dev
LOG_LEVEL=INFO

# --- baza de date ---
POSTGRES_USER=facturare
POSTGRES_PASSWORD=schimba_ma
POSTGRES_DB=facturare
DATABASE_URL=postgresql+psycopg://facturare:schimba_ma@db:5432/facturare

# --- cozi ---
REDIS_URL=redis://redis:6379/0

# --- criptare tokenuri SPV (Fernet, 32 bytes base64) ---
# genereaza: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- ANAF OAuth ---
# O SINGURA inregistrare pentru ambele medii. Separarea test/prod e doar pe calea de API.
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=https://facturare.fullstackit.ro/anaf/callback

# --- domenii Traefik ---
DOMAIN=facturare.fullstackit.ro
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=letsencrypt

# --- stocare ---
STORAGE_PATH=/data/storage
SCHEMATRON_PATH=/data/schematron/ro16931-ubl-1.0.9
